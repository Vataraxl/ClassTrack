<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 教务系统 WebView 导课网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 上下课提醒与 Android 16 / ColorOS 16 流体云实况通知 (Promoted Ongoing / Live Updates) 权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 11+ 包可见性声明：允许检测并携带空值 JSON 模板文件跳转 DeepSeek 等 AI 助手 -->
    <queries>
        <package android:name="com.deepseek.chat" />
        <package android:name="com.larus.nova" />
        <package android:name="com.moonshot.kimichat" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassTrack"
        android:usesCleartextTraffic="true"
        android:windowSoftInputMode="adjustResize">

        <!-- 屏幕比例与高刷新率适配声明 -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.5" />
        <meta-data
            android:name="notch.config"
            android:value="portrait|landscape" />

        <!-- 四大国产 OS 实况通知 / 流体云 / 原子岛 / 澎湃超级岛 / 灵动胶囊支持声明 -->
        <meta-data
            android:name="oplus.notification.fluid_cloud.support"
            android:value="true" />
        <meta-data
            android:name="vivo.notification.island.support"
            android:value="true" />
        <meta-data
            android:name="miui.notification.focus.support"
            android:value="true" />
        <meta-data
            android:name="com.hihonor.notification.live_view.support"
            android:value="true" />

        <!-- 用于向 DeepSeek 等 AI 应用安全分享空值主题 JSON 模板文件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ColorOS 流体云与课前自动提醒广播接收器 -->
        <receiver
            android:name=".system.CourseReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.classtrack.app.ACTION_DISMISS_FLUID_CLOUD" />
                <action android:name="com.classtrack.app.ACTION_TRIGGER_COURSE_REMINDER" />
                <action android:name="com.classtrack.app.ACTION_LIVE_TICK_FLUID_CLOUD" />
                <action android:name="com.classtrack.app.ACTION_CHECK_ACTIVE_REMINDER" />
                <action android:name="com.classtrack.app.ACTION_TEST_WATCH_BRIDGE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 系统级持久保活巡检任务（兜底校验 RTC 闹钟链与活跃课程状态） -->
        <service
            android:name=".system.CourseAlarmWatchdogJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 流体云后台平滑轮播前台服务（防止退后台后被 ColorOS 等系统快速冻结进程） -->
        <service
            android:name=".system.FluidCloudForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Real-time live class schedule status on status bar" />
        </service>

        <!-- 桌面黑胶/磁带小组件 -->
        <receiver
            android:name=".widget.ClassTrackWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.classtrack.app.ACTION_NEXT_WIDGET_LYRIC" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/classtrack_widget_info" />
        </receiver>

    </application>

</manifest>
